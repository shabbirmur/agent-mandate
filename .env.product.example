# Copy to .env.product. The real file is ignored by Git.
# Generate each 256-bit key independently, for example:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
INTERNAL_GRANT_KEY=replace-with-a-32-byte-base64url-key
APPROVAL_COOKIE_KEY=replace-with-a-different-32-byte-base64url-key

PRODUCT_PUBLIC_BASE_URL=http://127.0.0.1:8787
AGENT_MANDATE_TENANT_ID=default
DATABASE_TIMEOUT_MS=1000
REQUEST_TIMEOUT_MS=5000

# The MCP access token must carry scope agent-mandate:use and the documented
# tenant/principal/agent/workload/client identity claims.
PRODUCT_ACCESS_ISSUER=https://idp.example.com
PRODUCT_ACCESS_AUDIENCE=agent-mandate-mcp
PRODUCT_ACCESS_JWKS_URL=https://idp.example.com/.well-known/jwks.json
PRODUCT_ACCESS_AUTHORIZATION_URL=https://idp.example.com/oauth2/authorize
PRODUCT_ACCESS_TOKEN_URL=https://idp.example.com/oauth2/token
# PRODUCT_ACCESS_REGISTRATION_URL=https://idp.example.com/oauth2/register

# Browser approval uses a separate, freshly authenticated OIDC code flow.
APPROVAL_OIDC_ISSUER=https://idp.example.com
APPROVAL_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
APPROVAL_OIDC_AUTHORIZATION_URL=https://idp.example.com/oauth2/authorize
APPROVAL_OIDC_TOKEN_URL=https://idp.example.com/oauth2/token
APPROVAL_OIDC_CLIENT_ID=agent-mandate-approval
# APPROVAL_OIDC_CLIENT_SECRET=replace-only-for-a-confidential-client

# Install a GitHub App on exactly the sandbox repository and grant Issues:write.
# Paste the complete downloaded PEM on one line with line breaks encoded as \n.
GITHUB_APP_ID=replace-with-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-full-github-app-pem-on-one-line
GITHUB_INSTALLATION_ID=replace-with-installation-id
GITHUB_REPOSITORY_ID=replace-with-numeric-repository-id
GITHUB_REPOSITORY=owner/sandbox-repository
# GITHUB_CONNECTION_ID defaults to github-installation:<installation-id>
